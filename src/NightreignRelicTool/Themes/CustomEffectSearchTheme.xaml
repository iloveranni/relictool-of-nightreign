            <DataTrigger Binding="{Binding RelicColorId}" Value="1">
                <Setter Property="Background" Value="{StaticResource CustomEffectSlotBlueBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CustomEffectSlotBlueBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource CustomEffectTextBrush}" />
