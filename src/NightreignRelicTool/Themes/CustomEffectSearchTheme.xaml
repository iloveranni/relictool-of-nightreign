        <Setter Property="BorderBrush" Value="{StaticResource CustomEffectTextBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Background" Value="{StaticResource CustomEffectSlotWhiteBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ColorId}" Value="0"><Setter Property="Background" Value="{StaticResource CustomEffectSlotRedBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ColorId}" Value="1"><Setter Property="Background" Value="{StaticResource CustomEffectSlotBlueBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ColorId}" Value="2"><Setter Property="Background" Value="{StaticResource CustomEffectSlotYellowBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ColorId}" Value="3"><Setter Property="Background" Value="{StaticResource CustomEffectSlotGreenBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ColorId}" Value="4"><Setter Property="Background" Value="{StaticResource CustomEffectSlotWhiteBrush}" /></DataTrigger>
        </Style.Triggers>
