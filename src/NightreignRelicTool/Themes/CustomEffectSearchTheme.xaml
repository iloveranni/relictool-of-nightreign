            <DataTrigger Binding="{Binding RelicColorId}" Value="3">
                <Setter Property="Background" Value="{StaticResource CustomEffectSlotGreenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CustomEffectSlotGreenBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource CustomEffectTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelicColorId}" Value="4">
                <Setter Property="Background" Value="{StaticResource CustomEffectSlotWhiteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CustomEffectSlotWhiteBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource CustomEffectHeaderBrush}" />
            </DataTrigger>
        </Style.Triggers>
