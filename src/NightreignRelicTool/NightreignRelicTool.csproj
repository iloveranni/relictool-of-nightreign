<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>NightreignRelicTool</AssemblyName>
    <RootNamespace>NightreignRelicTool</RootNamespace>
    <AssemblyTitle>Relic Tool</AssemblyTitle>
    <Product>Relic Tool</Product>
    <Company>Relic Tool</Company>
    <Description>Relic Tool</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NuGetAudit>false</NuGetAudit>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3"
                      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <EmbeddedResource Include="..\..\_build\release-resources\ui-text.json.gz" LogicalName="NightreignRelicTool.Localization.Ui.json" />
    <EmbeddedResource Include="..\..\_build\release-resources\game-text-1.03.5.json.gz" LogicalName="NightreignRelicTool.Localization.Game.json" />
    <EmbeddedResource Include="..\..\_build\release-resources\game-text-bindings-1.03.5.json.gz" LogicalName="NightreignRelicTool.Localization.Bindings.json" />
    <Compile Include="..\..\_build\release-resources\ReleaseResourceIntegrity.g.cs" Link="Localization\ReleaseResourceIntegrity.g.cs" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="..\..\_build\release-resources\relic-scoring-model-1.03.5.json.gz"
                      LogicalName="NightreignRelicTool.Resources.ScoringModel.gz" />
    <EmbeddedResource Include="Resources\relic-catalog-1.03.5.compact.json.gz"
                      LogicalName="NightreignRelicTool.Resources.RelicCatalog.gz" />
    <EmbeddedResource Include="..\..\_build\release-resources\custom-effect-search-1.03.5.json.gz"
                      LogicalName="NightreignRelicTool.Resources.CustomEffectSearch.gz" />
    <EmbeddedResource Include="Resources\relic-inventory-layout-1.03.5.json"
                      LogicalName="NightreignRelicTool.Resources.RelicInventoryLayout.json" />
    <EmbeddedResource Include="Resources\nrpack-public-key.xml"
                      LogicalName="NightreignRelicTool.Resources.NrpackPublicKey.xml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\revenant_crawl_spritesheet.png" />
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="NightreignRelicTool.FinalUI.Icon.ico" />
  </ItemGroup>
  <PropertyGroup>
    <RelicPythonExecutable Condition="'$(RelicPythonExecutable)' == ''">python</RelicPythonExecutable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Target Name="PreparePublicResources" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(RelicPythonExecutable)&quot; -I -B &quot;$(MSBuildProjectDirectory)\..\..\tools\prepare_release_resources.py&quot;" />
  </Target>
</Project>
