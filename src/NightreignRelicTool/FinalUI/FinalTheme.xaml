<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NightreignRelicTool.FinalUI">
  <Style x:Key="FinalButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource CustomEffectMutedTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="local:WindowDrag.IsExcluded" Value="True"/>
    <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="2" CornerRadius="4" BorderBrush="#9E7C3D" BorderThickness="1"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
        <ContentPresenter x:Name="ContentHost" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26221C"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="#686156"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalCaptionButton" TargetType="Button" BasedOn="{StaticResource FinalButton}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>
  <Style x:Key="FinalScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <!-- The transparent grid receives input across the full 14 DIP lane. -->
      <Grid Background="Transparent"><Border x:Name="Ink" Width="5" CornerRadius="2.5" Background="{TemplateBinding Background}"/></Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ink" Property="Background" Value="#55524D"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Ink" Property="Background" Value="#77736B"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalScrollBar" TargetType="ScrollBar">
    <Setter Property="local:WindowDrag.IsExcluded" Value="True"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#393733"/>
    <Setter Property="Width" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Border Width="6" Background="Transparent"/>
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource FinalScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource FinalScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource FinalScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource FinalScrollBar}"/>
  <Style x:Key="FinalQuietScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource FinalScrollBar}">
    <Setter Property="Foreground" Value="#242321"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
        <Setter Property="Foreground" Value="#44413C"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="MaxWidth" Value="460"/><Setter Property="Background" Value="#181613"/><Setter Property="Foreground" Value="#F2E9D7"/>
    <Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#9E7C3D"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="local:WindowDrag.IsExcluded" Value="True"/>
    <Setter Property="Foreground" Value="{StaticResource CustomEffectGoldMutedBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Height="32" Background="Transparent">
        <Border Height="4" Background="#3A3227" CornerRadius="2" VerticalAlignment="Center"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#9E7C3D" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="14" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="12" Height="12" CornerRadius="6" Background="#BE9951"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#3A3227"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
